<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <TextureView
        android:id="@+id/previewTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.testtube.swinglines.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- spirit level, top centre of live view -->
    <com.testtube.swinglines.LevelView
        android:id="@+id/levelView"
        android:layout_width="130dp"
        android:layout_height="34dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp" />

    <!-- permanent top bar: menu toggle + rec indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_gravity="top">

        <Button
            android:id="@+id/btnMenu"
            style="@style/Pill"
            android:text="@string/menu" />

        <TextView
            android:id="@+id/recIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/rec_pill"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="@string/rec"
            android:visibility="gone" />
    </LinearLayout>

    <!-- collapsible live menu -->
    <LinearLayout
        android:id="@+id/liveMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:orientation="vertical"
        android:background="#D90B0F0D"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btnFlip" style="@style/Tool" android:text="@string/flip" />
            <Button android:id="@+id/btnSpeed" style="@style/Tool" android:text="@string/speed_normal" />
            <Button android:id="@+id/btnClips" style="@style/Tool" android:text="@string/clips" />
            <Button android:id="@+id/btnSetups" style="@style/Tool" android:text="@string/setups" />
            <Button android:id="@+id/btnSettings" style="@style/Tool" android:text="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/colorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btnLine" style="@style/Tool" android:text="@string/line" />
            <Button android:id="@+id/btnDraw" style="@style/Tool" android:text="@string/draw" />
            <Button android:id="@+id/btnCircle" style="@style/Tool" android:text="@string/circle" />
            <Button android:id="@+id/btnGrid" style="@style/Tool" android:text="@string/grid" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btnUndo" style="@style/Tool" android:text="@string/undo" />
            <Button android:id="@+id/btnClear" style="@style/Tool" android:text="@string/clear" />
            <Button android:id="@+id/btnStudent" style="@style/Tool" android:text="@string/student" />
            <Button android:id="@+id/btnCaps" style="@style/Tool" android:text="@string/caps" />
        </LinearLayout>
    </LinearLayout>

    <!-- live view keeps ONLY the record button on screen -->
    <ImageButton
        android:id="@+id/btnRecord"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:background="@drawable/rec_button"
        android:contentDescription="@string/record" />

    <!-- ============ instant replay panel ============ -->
    <FrameLayout
        android:id="@+id/reviewPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit" />

        <com.testtube.swinglines.OverlayView
            android:id="@+id/reviewOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:layout_gravity="top">

            <Button
                android:id="@+id/btnRevMenu"
                style="@style/Pill"
                android:text="@string/menu" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/fpsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:background="@drawable/pill_bg"
                android:textColor="#7EE787"
                android:textStyle="bold"
                android:textSize="12sp"
                android:text="@string/fps_placeholder" />
        </LinearLayout>

        <!-- collapsible replay menu -->
        <LinearLayout
            android:id="@+id/revMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="58dp"
            android:orientation="vertical"
            android:background="#D90B0F0D"
            android:padding="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <Button android:id="@+id/btnRevPlay" style="@style/Tool" android:text="@string/play" />
                <Button android:id="@+id/btnRevBack" style="@style/Tool" android:text="@string/frame_back" />
                <Button android:id="@+id/btnRevFwd" style="@style/Tool" android:text="@string/frame_fwd" />
                <Button android:id="@+id/btnSpeedSlow" style="@style/Tool" android:text="@string/spd_slowest" />
                <Button android:id="@+id/btnSpeedQuarter" style="@style/Tool" android:text="@string/spd_quarter" />
                <Button android:id="@+id/btnSpeedFull" style="@style/Tool" android:text="@string/spd_full" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <Button android:id="@+id/btnRevUndo" style="@style/Tool" android:text="@string/undo" />
                <Button android:id="@+id/btnRevClear" style="@style/Tool" android:text="@string/clear" />
                <Button android:id="@+id/btnShare" style="@style/Tool" android:text="@string/share" />
                <Button android:id="@+id/btnRevClose" style="@style/Tool" android:text="@string/back_to_camera" />
            </LinearLayout>
        </LinearLayout>

        <!-- the permanent scrub bar: the analysis control -->
        <SeekBar
            android:id="@+id/reviewSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="14dp"
            android:layout_marginBottom="26dp"
            android:paddingVertical="14dp" />
    </FrameLayout>

</FrameLayout>
