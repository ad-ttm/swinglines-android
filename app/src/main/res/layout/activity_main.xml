<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <TextureView
        android:id="@+id/previewTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.testtube.swinglines.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- spirit level, top centre of live view -->
    <com.testtube.swinglines.LevelView
        android:id="@+id/levelView"
        android:layout_width="130dp"
        android:layout_height="34dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp" />

    <!-- permanent top bar: menu toggle + rec indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_gravity="top">

        <Button
            android:id="@+id/btnMenu"
            style="@style/Pill"
            android:text="@string/menu" />

        <TextView
            android:id="@+id/recIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/rec_pill"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="@string/rec"
            android:visibility="gone" />
    </LinearLayout>

    <!-- collapsible live menu -->
    <LinearLayout
        android:id="@+id/liveMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:orientation="vertical"
        android:background="#D90B0F0D"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btnFlip" style="@style/Tool" android:text="@string/flip" />
            <Button android:id="@+id/btnSpeed" style="@style/Tool" android:text="@string/speed_normal" />
            <Button android:id="@+id/btnClips" style="@style/Tool" android:text="@string/clips" />
            <Button android:id="@+id/btnSetups" style="@style/Tool" android:text="@string/setups" />
            <Button android:id="@+id/btnSettings" style="@style/Tool" android:text="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/colorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btnLine" style="@style/Tool" android:text="@string/line" />
            <Button android:id="@+id/btnDraw" style="@style/Tool" android:text="@string/draw" />
            <Button android:id="@+id/btnCircle" style="@style/Tool" android:text="@string/circle" />
            <Button android:id="@+id/btnGrid" style="@style/Tool" android:text="@string/grid" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btnUndo" style="@style/Tool" android:text="@string/undo" />
            <Button android:id="@+id/btnClear" style="@style/Tool" android:text="@string/clear" />
            <Button android:id="@+id/btnStudent" style="@style/Tool" android:text="@string/student" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btnCompare" style="@style/Tool" android:text="@string/compare" />
            <Button android:id="@+id/btnCaps" style="@style/Tool" android:text="@string/caps" />
        </LinearLayout>
    </LinearLayout>

    <!-- live view keeps ONLY the record button on screen -->
    <ImageButton
        android:id="@+id/btnRecord"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:background="@drawable/rec_button"
        android:contentDescription="@string/record" />

    <!-- ============ instant replay panel ============ -->
    <FrameLayout
        android:id="@+id/reviewPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fit" />

        <com.testtube.swinglines.OverlayView
            android:id="@+id/reviewOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:layout_gravity="top">

            <Button
                android:id="@+id/btnRevMenu"
                style="@style/Pill"
                android:text="@string/menu" />

            <Button
                android:id="@+id/btnBackLive"
                style="@style/Pill"
                android:text="@string/back_live" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/fpsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:background="@drawable/pill_bg"
                android:textColor="#7EE787"
                android:textStyle="bold"
                android:textSize="12sp"
                android:text="@string/fps_placeholder" />
        </LinearLayout>

        <!-- collapsible replay menu -->
        <LinearLayout
            android:id="@+id/revMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="58dp"
            android:orientation="vertical"
            android:background="#D90B0F0D"
            android:padding="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <Button android:id="@+id/btnRevPlay" style="@style/Tool" android:text="@string/play" />
                <Button android:id="@+id/btnSpeedSlow" style="@style/Tool" android:text="@string/spd_slowest" />
                <Button android:id="@+id/btnSpeedQuarter" style="@style/Tool" android:text="@string/spd_quarter" />
                <Button android:id="@+id/btnSpeedFull" style="@style/Tool" android:text="@string/spd_full" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <Button android:id="@+id/btnRevUndo" style="@style/Tool" android:text="@string/undo" />
                <Button android:id="@+id/btnRevClear" style="@style/Tool" android:text="@string/clear" />
                <Button android:id="@+id/btnShare" style="@style/Tool" android:text="@string/share" />
                <Button android:id="@+id/btnShareLines" style="@style/Tool" android:text="@string/share_lines" />
                <Button android:id="@+id/btnRevClose" style="@style/Tool" android:text="@string/back_to_camera" />
            </LinearLayout>
        </LinearLayout>

        <!-- permanent scrubbing cluster: counter, coarse bar, jog strip + steps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/frameCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#CFE3D6"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:text="@string/frame_counter_zero" />

            <!-- coarse bar retired at Rich's request - the jog wheel is the control.
                 Kept in the layout (gone) so position tracking keeps working. -->
            <SeekBar
                android:id="@+id/reviewSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button android:id="@+id/btnRevStart" style="@style/Tool" android:text="@string/to_start" />
                <Button android:id="@+id/btnRevBack" style="@style/Tool" android:text="@string/frame_back" />

                <com.testtube.swinglines.JogStrip
                    android:id="@+id/jogStrip"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp" />

                <Button android:id="@+id/btnRevFwd" style="@style/Tool" android:text="@string/frame_fwd" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ============ split-screen compare ============ -->
    <LinearLayout
        android:id="@+id/comparePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerA"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit" />

            <Button
                android:id="@+id/chooseA"
                style="@style/Pill"
                android:layout_gravity="center"
                android:text="@string/choose_swing" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:background="#B00B0F0D"
                android:paddingHorizontal="6dp">

                <SeekBar android:id="@+id/seekA" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button android:id="@+id/startA" style="@style/Tool" android:text="@string/to_start" />
                    <Button android:id="@+id/ppA" style="@style/Tool" android:text="@string/play_icon" />
                    <Button android:id="@+id/backA" style="@style/Tool" android:text="@string/frame_back" />

                    <com.testtube.swinglines.JogStrip
                        android:id="@+id/jogA"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp" />

                    <Button android:id="@+id/fwdA" style="@style/Tool" android:text="@string/frame_fwd" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <View android:layout_width="match_parent" android:layout_height="2dp" android:background="#1D2620" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerB"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:resize_mode="fit" />

            <Button
                android:id="@+id/chooseB"
                style="@style/Pill"
                android:layout_gravity="center"
                android:text="@string/choose_swing" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:background="#B00B0F0D"
                android:paddingHorizontal="6dp">

                <SeekBar android:id="@+id/seekB" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button android:id="@+id/startB" style="@style/Tool" android:text="@string/to_start" />
                    <Button android:id="@+id/ppB" style="@style/Tool" android:text="@string/play_icon" />
                    <Button android:id="@+id/backB" style="@style/Tool" android:text="@string/frame_back" />

                    <com.testtube.swinglines.JogStrip
                        android:id="@+id/jogB"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp" />

                    <Button android:id="@+id/fwdB" style="@style/Tool" android:text="@string/frame_fwd" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="#0B0F0D"
            android:padding="6dp">

            <Button android:id="@+id/cmpPlayBoth" style="@style/Tool" android:text="@string/play_both" />
            <Button android:id="@+id/cmpPauseBoth" style="@style/Tool" android:text="@string/pause_both" />
            <Button android:id="@+id/cmpQuarter" style="@style/Tool" android:text="@string/spd_quarter" />
            <Button android:id="@+id/cmpFull" style="@style/Tool" android:text="@string/spd_full" />
            <Button android:id="@+id/cmpClose" style="@style/Tool" android:text="@string/back_to_camera" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ clips: thumbnail grid ============ -->
    <LinearLayout
        android:id="@+id/clipsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B0F0D"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <Button android:id="@+id/clipsClose" style="@style/Pill" android:text="@string/back_to_camera" />

            <TextView
                android:id="@+id/clipsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/clips_title"
                android:textColor="#EEF2EF"
                android:textStyle="bold"
                android:textSize="15sp" />

            <Button android:id="@+id/clipsImport" style="@style/Pill" android:text="@string/import_short" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/studentChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>

        <GridView
            android:id="@+id/clipsGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="3"
            android:horizontalSpacing="6dp"
            android:verticalSpacing="6dp"
            android:padding="6dp"
            android:stretchMode="columnWidth" />
    </LinearLayout>

</FrameLayout>
