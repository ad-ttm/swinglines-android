<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#EEF2EF</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Tool">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:paddingHorizontal">9dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#EEF2EF</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
